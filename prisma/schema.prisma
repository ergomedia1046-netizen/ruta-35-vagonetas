generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PASSENGER
  DRIVER
  ADMIN
}

enum Direction {
  YACUIBA_TO_VILLAMONTES
  VILLAMONTES_TO_YACUIBA
}

enum BookingKind {
  ORDINARY
  EXPRESS
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ASSIGNED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  CASH
  QR
  COMBINED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REVIEW_REQUIRED
  REJECTED
}

enum PartKind {
  CASH
  QR
}

enum PartStatus {
  PENDING
  RECEIVED
  VERIFIED
  REJECTED
}

enum VehicleStatus {
  AVAILABLE
  QUEUED
  ON_TRIP
  INACTIVE
}

enum TripStatus {
  ASSIGNED
  TO_PICKUP
  PICKED_UP
  IN_TRANSIT
  ARRIVED
  COMPLETED
}

enum IncidentStatus {
  OPEN
  REVIEWED
  CORRECTED
}

enum IncidentDecision {
  SUBSTANTIATED
  NOT_SUBSTANTIATED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  role         Role
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  bookings     Booking[]     @relation("PassengerBookings")
  shifts       DriverShift[]
  auditEvents  AuditEvent[]
  sessions     Session[]
  driverPresence DriverPresence?
  tripEvents TripEvent[]
  combinedPaymentRestricted Boolean @default(false)
  reportedIncidents Incident[] @relation("IncidentReporter")
  reviewedIncidents Incident[] @relation("IncidentReviewer")
  restrictions PaymentRestriction[] @relation("RestrictedUser")
  createdRestrictions PaymentRestriction[] @relation("RestrictionCreator")
  revokedRestrictions PaymentRestriction[] @relation("RestrictionRevoker")
}

model Vehicle {
  id           String        @id @default(cuid())
  plate        String        @unique
  capacity     Int           @default(7)
  status       VehicleStatus @default(AVAILABLE)
  queueEntries QueueEntry[]
  assignments  Assignment[]
  shifts       DriverShift[]
  trips        Trip[]
}

model DriverShift {
  id        String    @id @default(cuid())
  userId    String
  vehicleId String
  startsAt  DateTime
  endsAt    DateTime?
  user      User      @relation(fields: [userId], references: [id])
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id])

  @@index([userId, endsAt])
}

model QueueEntry {
  id        String    @id @default(cuid())
  vehicleId String
  direction Direction
  arrivedAt DateTime  @default(now())
  position  Int
  active    Boolean   @default(true)
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id])

  @@index([direction, active, arrivedAt, position])
}

model QueueDirectionLock {
  direction Direction @id
}

model Booking {
  id              String        @id @default(cuid())
  passengerId     String?
  direction       Direction
  origin          String
  destination     String
  pickupPoint     String
  pickupReference String?
  passengers      Int
  kind            BookingKind   @default(ORDINARY)
  totalBs         Int
  status          BookingStatus @default(PENDING)
  paymentMethod   PaymentMethod
  createdAt       DateTime      @default(now())
  confirmedAt     DateTime?
  idempotencyKey  String        @unique
  passenger       User?         @relation("PassengerBookings", fields: [passengerId], references: [id])
  assignment      Assignment?
  payment         Payment?
  incidents       Incident[]

  @@index([direction, status, confirmedAt])
}

model Assignment {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  vehicleId  String
  tripId     String?
  actualPassengers Int?
  assignedAt DateTime @default(now())
  booking    Booking  @relation(fields: [bookingId], references: [id])
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  trip       Trip?    @relation(fields: [tripId], references: [id])
}

model Trip {
  id          String     @id @default(cuid())
  vehicleId   String
  direction   Direction
  status      TripStatus @default(ASSIGNED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  vehicle     Vehicle    @relation(fields: [vehicleId], references: [id])
  assignments Assignment[]
  events      TripEvent[]

  @@index([vehicleId, status])
}

model TripEvent {
  id             String     @id @default(cuid())
  tripId         String
  actorId        String
  action         String
  fromStatus     TripStatus?
  toStatus       TripStatus
  idempotencyKey String     @unique
  details        Json
  createdAt      DateTime   @default(now())
  trip           Trip       @relation(fields: [tripId], references: [id])
  actor          User       @relation(fields: [actorId], references: [id])

  @@index([tripId, createdAt])
}

model Payment {
  id        String        @id @default(cuid())
  bookingId String        @unique
  method    PaymentMethod
  totalBs   Int
  status    PaymentStatus @default(PENDING)
  parts     PaymentPart[]
  booking   Booking       @relation(fields: [bookingId], references: [id])
}

model PaymentPart {
  id         String     @id @default(cuid())
  paymentId  String
  kind       PartKind
  amountBs   Int
  status     PartStatus @default(PENDING)
  verifiedBy String?
  verifiedAt DateTime?
  payment    Payment    @relation(fields: [paymentId], references: [id])

  @@index([paymentId, kind])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  details    Json
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model DriverPresence {
  userId     String   @id
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Incident {
  id            String           @id @default(cuid())
  bookingId     String
  reportedById  String
  amountBs      Int
  status        IncidentStatus   @default(OPEN)
  reportedAt    DateTime         @default(now())
  reviewedById  String?
  decision      IncidentDecision?
  reviewNotes   String?
  reviewedAt    DateTime?
  correctedAt   DateTime?
  correctionNotes String?
  booking       Booking          @relation(fields: [bookingId], references: [id])
  reporter      User             @relation("IncidentReporter", fields: [reportedById], references: [id])
  reviewer      User?            @relation("IncidentReviewer", fields: [reviewedById], references: [id])
  restriction   PaymentRestriction?

  @@index([status, reportedAt])
  @@index([bookingId, reportedAt])
}

model PaymentRestriction {
  id          String   @id @default(cuid())
  userId      String
  incidentId  String   @unique
  createdById String
  revokedById String?
  active      Boolean  @default(true)
  reason      String
  createdAt   DateTime @default(now())
  revokedAt   DateTime?
  user        User     @relation("RestrictedUser", fields: [userId], references: [id])
  incident    Incident @relation(fields: [incidentId], references: [id])
  createdBy   User     @relation("RestrictionCreator", fields: [createdById], references: [id])
  revokedBy   User?    @relation("RestrictionRevoker", fields: [revokedById], references: [id])

  @@index([userId, active])
}
